# CPU Worker (SIM Specialist) — SBERT only
FROM python:3.11-slim

# build tools (for PyTorch)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential && rm -rf /var/lib/apt/lists/*

# Python packages (CPU-only PyTorch + sentence-transformers only)
RUN pip install --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir \
    redis pillow requests sentence-transformers numpy

WORKDIR /app
COPY shared/ /app/shared/
COPY workers/worker.py .

# warm-up: SBERT only
RUN python -c "\
from sentence_transformers import SentenceTransformer;\
print('Downloading SBERT all-MiniLM-L6-v2...');\
SentenceTransformer('all-MiniLM-L6-v2');\
print('Model cached successfully.');\
"

CMD ["python", "worker.py"]
