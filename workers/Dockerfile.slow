# CPU Worker (Generalist) — lightweight CPU image with 3 models
FROM python:3.10-slim

# build tools (for PyTorch)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential && rm -rf /var/lib/apt/lists/*

# Python packages (CPU-only PyTorch from official source, others from PyPI)
RUN pip install --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir \
    transformers redis pillow requests sentence-transformers numpy

WORKDIR /app
COPY shared/ /app/shared/
COPY workers/worker.py .

# warm-up: pre-download 3 CPU models at build time
RUN python -c "\
from transformers import pipeline, T5Tokenizer, T5ForConditionalGeneration;\
from sentence_transformers import SentenceTransformer;\
print('Downloading SBERT all-MiniLM-L6-v2...');\
SentenceTransformer('all-MiniLM-L6-v2');\
print('Downloading t5-small...');\
T5Tokenizer.from_pretrained('t5-small');\
T5ForConditionalGeneration.from_pretrained('t5-small');\
print('Downloading DistilBERT SST-2...');\
pipeline('sentiment-analysis', model='distilbert-base-uncased-finetuned-sst-2-english');\
print('All 3 models cached successfully.');\
"

CMD ["python", "worker.py"]
