# ───────────────────────────────────────────────
# CPU Worker (Slow Node) — lightweight CPU image
# ───────────────────────────────────────────────
FROM python:3.10-slim

# build tools (for PyTorch)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential && rm -rf /var/lib/apt/lists/*

# Python packages (CPU-only PyTorch from official source, others from PyPI)
RUN pip install --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir \
    transformers redis pillow requests

WORKDIR /app
COPY worker.py .

# warm-up: pre-download NLP models at build time
RUN python -c "\
from transformers import pipeline;\
print('Downloading NLP model...');\
pipeline('sentiment-analysis', model='distilbert-base-uncased-finetuned-sst-2-english');\
print('Model cached successfully.');\
"

CMD ["python", "worker.py"]
