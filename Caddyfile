# Caddy reverse proxy for the cloud deployment.
#
# Serves the Streamlit control dashboard at the root and Grafana under /grafana.
# With a real domain in $DOMAIN, Caddy obtains a Let's Encrypt certificate
# automatically (ports 80 and 443 must be open in the security group).
#
#   DOMAIN=demo.example.com docker compose -f docker-compose.yml -f docker-compose.cloud.yml up -d
#
# On a bare IP or localhost, Caddy serves plain HTTP on port 80.

{$DOMAIN} {
	# Grafana under a sub-path. The path is passed through *unchanged* (handle,
	# not handle_path): Grafana is configured with GF_SERVER_ROOT_URL=.../grafana
	# and SERVE_FROM_SUB_PATH=true, so it serves the /grafana prefix itself.
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# Streamlit control dashboard (websockets are handled by Caddy natively).
	# It can trigger workload generation and mounts the Docker socket, so the
	# public demo is protected with HTTP basic auth (credentials are in README).
	handle {
		basic_auth {
			demo $2b$10$hfPNqcWfwRkxlKb0slHvUewrIApL3ozVe3BrNDj7aRpstU47Uq7pe
		}
		reverse_proxy streamlit-dashboard:8501
	}
}
