# Git ignore  

# Docs  
文档/

# Input (seed images)  
storage/inputs/*.jpg
storage/inputs/*.jpeg
storage/inputs/*.png
storage/inputs/*.webp
storage/inputs/*.gif
storage/inputs/*.bmp

# keep prompts.txt and seeds/ dir structure
!storage/inputs/seeds/
!storage/inputs/seeds/*
!storage/inputs/prompts.txt

# Output  
storage/outputs/*
!storage/outputs/.gitkeep

# SQLite
storage/*.db
storage/*.db-wal
storage/*.db-shm
storage/*.db.backup*

# Experiment raw data (regenerable via scripts/run_experiments.py; keep charts)
experiments/exp*/*_run*.csv
experiments/manifest.csv

# Python
__pycache__/
*.pyc
*.pyo

# Env  
.env

# Gateway JSON logs (shipped to ELK, regenerated at runtime)
logs/

# Ansible — real inventory and secrets are machine-local
ansible/inventory.ini
ansible/group_vars/*.vault.yml

# IDE / Agent local config  
.vscode/
.claude/
.agents/
