# ---Git 忽略规则

# ── 项目文档 ──
文档/

# ── 输入目录（种子图片）──
storage/inputs/*.jpg
storage/inputs/*.jpeg
storage/inputs/*.png
storage/inputs/*.webp
storage/inputs/*.gif
storage/inputs/*.bmp

# 保留 prompts.txt 和 seeds/ 目录结构
!storage/inputs/seeds/
!storage/inputs/seeds/*
!storage/inputs/prompts.txt

# ── 输出目录 ──
storage/outputs/*
!storage/outputs/.gitkeep

# ── SQLite 数据库 ──
storage/*.db
storage/*.db-wal
storage/*.db-shm

# ── Python ──
__pycache__/
*.pyc
*.pyo

# ── 环境变量 ──
.env

# ── IDE 和 Agent 本地配置 ──
.vscode/
.claude/
.agents/
