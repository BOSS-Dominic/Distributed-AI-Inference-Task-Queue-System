# Git ignore  

# Docs  
文档/

# Input (seed images)  
storage/inputs/*.jpg
storage/inputs/*.jpeg
storage/inputs/*.png
storage/inputs/*.webp
storage/inputs/*.gif
storage/inputs/*.bmp

# keep prompts.txt and seeds/ dir structure
!storage/inputs/seeds/
!storage/inputs/seeds/*
!storage/inputs/prompts.txt

# Output  
storage/outputs/*
!storage/outputs/.gitkeep

# SQLite  
storage/*.db
storage/*.db-wal
storage/*.db-shm

# Python  
__pycache__/
*.pyc
*.pyo

# Env  
.env

# IDE / Agent local config  
.vscode/
.claude/
.agents/
