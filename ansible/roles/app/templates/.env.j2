# Rendered to <app_dir>/.env on the cloud host. Secrets come from the
# environment or ansible-vault — never commit rendered .env files.
DOMAIN={{ domain }}
CLOUD_URL={{ cloud_url }}
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}
# Keep the compose project name stable across checkout directories so a
# deployment from /opt/task-queue adopts the containers created from another
# path instead of conflicting on the explicit container_name values.
COMPOSE_PROJECT_NAME={{ compose_project_name }}
{% if cadvisor_image %}
CADVISOR_IMAGE={{ cadvisor_image }}
{% endif %}
